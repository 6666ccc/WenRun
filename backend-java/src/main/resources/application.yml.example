# 复制为 application.yml 后填写本地数据库密码，该文件已被 gitignore。
server:
  port: 8080

spring:
  application:
    name: WenRun

  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 21MB

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/wenrun?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai}
    username: ${SPRING_DATASOURCE_USERNAME:root}
    password: ${SPRING_DATASOURCE_PASSWORD:}

mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  type-aliases-package: com.wenrun.entity
  configuration:
    map-underscore-to-camel-case: true

logging:
  charset:
    console: UTF-8
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-no-request-id}] %logger{36} - %msg%n"
  level:
    com.wenrun: info

wenrun:
  auth:
    token-ttl: ${AUTH_TOKEN_TTL:8h}
