# 复制为 application.yml 后填写本地数据库密码，该文件已被 gitignore。
server:
  port: 8080

spring:
  application:
    name: WenRun

  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 21MB

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/wenrun?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai}
    username: ${SPRING_DATASOURCE_USERNAME:root}
    password: ${SPRING_DATASOURCE_PASSWORD:}

mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  type-aliases-package: com.wenrun.entity,com.wenrun.ai.knowledge.entity
  configuration:
    map-underscore-to-camel-case: true

ai:
  service:
    base-url: http://127.0.0.1:8000
    chat-path: /v1/chat
    chat-stream-path: /v1/chat/stream
    chat-resume-stream-path: /v1/chat/resume/stream
    health-path: /health
    api-key: ${AI_SERVICE_API_KEY:}
    connect-timeout: 5s
    read-timeout: 120s
    stream-read-timeout: 10m
    knowledge-ingest-path: /v1/knowledge/ingest
    knowledge-delete-path: /v1/knowledge/{knowledgeBase}/{documentId}

  delegation:
    secret: ${AI_DELEGATION_SECRET}
    expiry-seconds: ${AI_DELEGATION_EXPIRY_SECONDS:300}

  knowledge:
    storage:
      root: ./data/knowledge
      max-file-size: 20MB
    tasks:
      core-pool-size: 2
      max-pool-size: 4
      queue-capacity: 100
      stale-after: 30m

logging:
  level:
    com.wenrun: debug
