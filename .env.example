# Copy to the repository root as .env. Compose reads that file automatically.
APP_ORIGIN=https://hospital.example.com
PANEL_NETWORK=1panel-network
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18080
RELEASE_TAG=local
# Passwords: use at least 32 hexadecimal characters (safe in Redis URLs).
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
REDIS_PASSWORD=
AI_SERVICE_API_KEY=
# Base64 of at least 32 random bytes, shared by Java and Python.
AI_DELEGATION_SIGNING_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=
EMBEDDING_MODEL=
TAVILY_API_KEY=
INTENT_BACKEND=jev
TOKENDANCE_API_KEY=
# No bundled Ollama. With no Jev key/local service, routing falls back to cloud.
INTENT_OLLAMA_BASE_URL=http://ollama:11434/v1
