# 前端（开发可留空，走 Vite 代理）
VITE_API_BASE_URL=
WENRUN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Java
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/wenrun?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=请与MYSQL_ROOT_PASSWORD保持一致
AI_SERVICE_BASE_URL=http://ai-python:8000
# Java ↔ Python 服务间共享 Key（请使用随机字符串；不要提交真实 .env）
AI_SERVICE_API_KEY=请替换为随机服务间密钥
AUTH_TOKEN_TTL=8h

# MySQL
MYSQL_DATABASE=wenrun
MYSQL_ROOT_PASSWORD=请替换为本地数据库密码
