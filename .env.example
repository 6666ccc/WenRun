# 前端（开发可留空，走 Vite 代理）
VITE_API_BASE_URL=
WENRUN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Java
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/wenrun?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=请与MYSQL_ROOT_PASSWORD保持一致
AI_SERVICE_BASE_URL=http://ai-python:8000
# Java ↔ Python 服务间共享 Key（请使用随机字符串；不要提交真实 .env）
AI_SERVICE_API_KEY=请替换为随机服务间密钥
# Java 签发、Python 验签使用的 Base64 密钥；解码后至少 32 字节
AI_DELEGATION_SIGNING_SECRET=请替换为Base64编码的随机密钥
AUTH_TOKEN_TTL=8h

# Redis：开发 Compose 里主机名是 redis；本机 Java 直连本机 Redis 时改成 host.docker.internal
# 生产 Compose（docker-compose.prod.yml）里 Redis 与 Java 同网，主机名固定为 redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false
WENRUN_AUTH_SESSION_STORE=redis

# Agent 会话记忆（LangGraph checkpointer）。必须 Redis 8+，db 与登录 Session 分开。
AI_REDIS_URL=redis://redis:6379/1
AI_CHECKPOINT_TTL_MINUTES=1440

# Python 调 Java 内部 Tool API。生产 Compose 默认 http://backend-java:8080
JAVA_TOOL_BASE_URL=http://backend-java:8080
JAVA_TOOL_TIMEOUT_SECONDS=5

# MySQL
MYSQL_DATABASE=wenrun
MYSQL_ROOT_PASSWORD=请替换为本地数据库密码
