# 前端（开发可留空，走 Vite 代理）
VITE_API_BASE_URL=
WENRUN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Java
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/wenrun?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
AI_SERVICE_BASE_URL=http://localhost:8000
# Java ↔ Python 服务间共享 Key（不是模型厂商 API Key；本地可用 dev-internal-key，部署时替换）
AI_SERVICE_API_KEY=dev-internal-key
AI_DELEGATION_SECRET=
AI_DELEGATION_EXPIRY_SECONDS=300
AI_INTERNAL_API_KEY=dev-internal-key
AI_JAVA_BASE_URL=http://localhost:8080
AI_CHECKPOINT_PATH=./data/checkpoints.sqlite

# Python
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wenrun
QDRANT_HOSPITAL_COLLECTION=wenrun_hospital_custom
QDRANT_MEDICAL_COLLECTION=wenrun_medical_general
QDRANT_MEMORY_COLLECTION=wenrun_conversation_memory
# 模型厂商 API Key：只注入 Python，不要传给 Java 或前端
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_CHAT_MODEL=
EMBEDDING_MODEL=

# MySQL
MYSQL_DATABASE=wenrun
MYSQL_ROOT_PASSWORD=
