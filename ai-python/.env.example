# 大模型与 Embedding（兼容 OpenAI 协议的服务）
DASHSCOPE_API_KEY=请替换为模型服务密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=请替换为聊天模型名称
EMBEDDING_MODEL=请替换为向量模型名称

# 意图级联路由。阈值必须依据 evals/intent_cases.jsonl 的验证结果调整。
INTENT_LIGHTWEIGHT_ENABLED=true
INTENT_LABEL_THRESHOLD=0.50
INTENT_ACCEPTANCE_THRESHOLD=0.60
INTENT_AMBIGUITY_MARGIN=0.12
INTENT_OOD_SIMILARITY_THRESHOLD=0.08

# Qdrant
QDRANT_URL=http://host.docker.internal:6333
QDRANT_TIMEOUT=10
QDRANT_HOSPITAL_COLLECTION=wenrun_hospital_custom

# RAG 生命周期的 MySQL 权威元数据；留空 HOST 时仅允许开发态 Qdrant-only 运行。
RAG_METADATA_MYSQL_HOST=
RAG_METADATA_MYSQL_PORT=3306
RAG_METADATA_MYSQL_DATABASE=wenrun
RAG_METADATA_MYSQL_USER=
RAG_METADATA_MYSQL_PASSWORD=

# Java ↔ Python 服务间共享 Key；必须与根目录 .env 的 AI_SERVICE_API_KEY 一致
AI_INTERNAL_API_KEY=请替换为随机服务间密钥

# 与根目录 .env 的 AI_DELEGATION_SIGNING_SECRET 完全一致；必须为 Base64 密钥
AI_DELEGATION_SIGNING_SECRET=请替换为Base64编码的随机密钥

# Python Tool 调用 Java 内部业务接口。本机分别启动用 http://localhost:8080；Docker Compose 用 http://backend-java:8080
JAVA_TOOL_BASE_URL=http://localhost:8080
JAVA_TOOL_TIMEOUT_SECONDS=5

# 知识节点联网兜底（可选）
TAVILY_API_KEY=

# 会话记忆（LangGraph checkpointer）。留空则不保存 checkpoint；Java 仍可提供有限 MySQL 历史。
# 必须是 Redis 8+（自带 RedisJSON 与 RediSearch）；RediSearch 只能用 db0，Java Session 用 db1。
AI_REDIS_URL=redis://localhost:6379/0
# checkpoint 存活时长（分钟），读到即续期
AI_CHECKPOINT_TTL_MINUTES=1440
AI_CONTEXT_TOTAL_TOKENS=8000
AI_CONTEXT_SYSTEM_TOKENS=2000
AI_CONTEXT_SUMMARY_TOKENS=1200
AI_CONTEXT_RECENT_TOKENS=2400
AI_CONTEXT_EXTERNAL_TOKENS=2400
AI_SUMMARY_TRIGGER_TOKENS=5000
AI_SUMMARY_MESSAGE_LIMIT=12
