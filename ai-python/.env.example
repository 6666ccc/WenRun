# 大模型与 Embedding（兼容 OpenAI 协议的服务）
DASHSCOPE_API_KEY=请替换为模型服务密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=请替换为聊天模型名称
EMBEDDING_MODEL=请替换为向量模型名称

# 意图级联：规则 → Jev（默认）或本地 Ollama → 云端 LLM。
# 切换后重启服务；切回本地只需设置 INTENT_BACKEND=ollama。
INTENT_BACKEND=jev
# 填写 OpenRouter API key；留空时先回退到 Ollama，不可用或不确定时再升级云端 LLM。
TOKENDANCE_API_KEY=
# TypeSafe 协议：BASE_URL 后追加 /systemone，不使用 Chat Completions。
INTENT_JEV_BASE_URL=https://openrouter.ai/api/v1
INTENT_JEV_MODEL=typesafe/jev-1.13
INTENT_JEV_TIMEOUT_SECONDS=10
# 每个独立判断的选中/排除置信度门槛，需用实际样本校准。
INTENT_JEV_ACCEPTANCE_THRESHOLD=0.70

# 保留本地 Ollama，供随时切换。
INTENT_OLLAMA_BASE_URL=http://192.168.86.36:11434/v1
INTENT_OLLAMA_MODEL=deepseek-r1:1.5b
INTENT_OLLAMA_TIMEOUT_SECONDS=25
INTENT_OLLAMA_ACCEPTANCE_THRESHOLD=0.70
INTENT_OLLAMA_AMBIGUITY_MARGIN=0.15

# 将每个模型/Agent 的最终输出写入结构化日志；手机号、证件号、地址和链接会被遮盖。
# 医疗回答仍可能包含健康信息；设为 false 可关闭内容日志。默认最多记录 2000 字符。
AI_LOG_AGENT_OUTPUTS=true
AI_AGENT_OUTPUT_LOG_MAX_CHARS=2000

# Chroma（进程内持久化目录，类似 SQLite）
CHROMA_PERSIST_DIR=
CHROMA_HOSPITAL_COLLECTION=wenrun_hospital_custom

# RAG 生命周期的 MySQL 权威元数据；留空 HOST 时仅允许开发态 Chroma-only 运行。
RAG_METADATA_MYSQL_HOST=
RAG_METADATA_MYSQL_PORT=3306
RAG_METADATA_MYSQL_DATABASE=wenrun
RAG_METADATA_MYSQL_USER=
RAG_METADATA_MYSQL_PASSWORD=

# Java ↔ Python 服务间共享 Key；必须与根目录 .env 的 AI_SERVICE_API_KEY 一致
AI_INTERNAL_API_KEY=请替换为随机服务间密钥

# 与根目录 .env 的 AI_DELEGATION_SIGNING_SECRET 完全一致；必须为 Base64 密钥
AI_DELEGATION_SIGNING_SECRET=请替换为Base64编码的随机密钥

# Python Tool 调用 Java 内部业务接口。本机分别启动用 http://localhost:8080；Docker Compose 用 http://backend-java:8080
JAVA_TOOL_BASE_URL=http://localhost:8080
JAVA_TOOL_TIMEOUT_SECONDS=5

# 知识节点联网兜底（可选）
TAVILY_API_KEY=

# 会话记忆（LangGraph checkpointer）。留空则不保存 checkpoint；Java 分页补齐摘要之后的全部 MySQL 历史。
# 必须是 Redis 8+（自带 RedisJSON 与 RediSearch）；RediSearch 只能用 db0，Java Session 用 db1。
AI_REDIS_URL=redis://localhost:6379/0
# checkpoint 存活时长（分钟），读到即续期
AI_CHECKPOINT_TTL_MINUTES=1440
AI_CONTEXT_TOTAL_TOKENS=8000
AI_CONTEXT_SYSTEM_TOKENS=2000
AI_CONTEXT_SUMMARY_TOKENS=1200
AI_CONTEXT_RECENT_TOKENS=2400
AI_CONTEXT_EXTERNAL_TOKENS=2400
AI_SUMMARY_TRIGGER_TOKENS=3000
AI_SUMMARY_MESSAGE_LIMIT=12

# 下一轮开始压缩；恢复读取量与估算模型输入预算独立。
AI_SUMMARY_KEEP_MESSAGES=6
AI_RECOVERY_MAX_MESSAGES=20000
AI_RECOVERY_TIMEOUT_SECONDS=60
